# ==============================================================================
# Part-time Coder — Environment Configuration Template (.env.example)
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to .env.local for local development:
#      cp .env.example .env.local
# 2. Fill in development values as needed.
# 3. NEVER COMMIT REAL CREDENTIALS OR .env FILES TO GIT.
# 4. Generate random secrets using: openssl rand -hex 32
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Runtime Environment
# ------------------------------------------------------------------------------
# NODE_ENV: development | test | production
NODE_ENV=development

# APP_ENV: local | test | staging | production
APP_ENV=local

# Web and Worker server ports
PORT=3000
WORKER_PORT=3001

# Canonical Public URL for the application
PUBLIC_APP_URL=http://localhost:3000

# Logging Level: debug | info | warn | error
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 2. Database (MongoDB Atlas)
# ------------------------------------------------------------------------------
# Local development can use local MongoDB or Atlas M0 free tier.
# Format: mongodb://localhost:27017/ptc_dev or mongodb+srv://<user>:<password>@cluster0.mongodb.net/ptc_dev
MONGODB_URI=mongodb://localhost:27017/part_time_coder_dev

# ------------------------------------------------------------------------------
# 3. Session & Security
# ------------------------------------------------------------------------------
# Minimum 32-character secret for signing sessions and cryptographic tokens
# Generate with: openssl rand -hex 32
SESSION_SECRET=replace_with_at_least_32_character_random_hex_string_for_session

# Cookie name for user sessions
SESSION_COOKIE_NAME=ptc_session

# Set to true in production HTTPS environments (automatically required when APP_ENV=production)
SESSION_COOKIE_SECURE=false

# 32-byte key for encrypting third-party OAuth access/refresh tokens in MongoDB
# Generate with: openssl rand -hex 32 (Required when APP_ENV=production)
INTEGRATION_ENCRYPTION_KEY=replace_with_at_least_32_character_hex_for_aes_encryption

# ------------------------------------------------------------------------------
# 4. Firebase Authentication (Server-Side Admin SDK)
# ------------------------------------------------------------------------------
# Obtain from Firebase Console -> Project Settings -> Service Accounts -> Generate Private Key
FIREBASE_PROJECT_ID=part-time-coder-dev
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-dummy@part-time-coder-dev.iam.gserviceaccount.com
# Format private key with escaped newlines: "-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgk...=\n-----END PRIVATE KEY-----\n"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\ndummy_private_key_replace_for_local_development\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------------------
# 5. Background Worker Runtime
# ------------------------------------------------------------------------------
WORKER_POLL_INTERVAL_MS=2000
WORKER_LEASE_DURATION_MS=60000
WORKER_CONCURRENCY=5

# ------------------------------------------------------------------------------
# 6. Media Storage (Cloudinary - Optional in local development)
# ------------------------------------------------------------------------------
# Set to true only if testing real asset uploads
ENABLE_CLOUDINARY=false
CLOUDINARY_CLOUD_NAME=dummy-cloud-name
CLOUDINARY_API_KEY=dummy-api-key
CLOUDINARY_API_SECRET=dummy-api-secret

# ------------------------------------------------------------------------------
# 7. Browser-Visible Public Variables (Prefixed with NEXT_PUBLIC_)
# ------------------------------------------------------------------------------
# NEVER put private keys, secrets, or database URLs in NEXT_PUBLIC_ variables!
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=en

# Firebase Client Configuration (Public API Key & Project Identifier)
NEXT_PUBLIC_FIREBASE_API_KEY=dummy_public_api_key_for_client
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=part-time-coder-dev.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=part-time-coder-dev
