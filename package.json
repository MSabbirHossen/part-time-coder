{
  "name": "part-time-coder",
  "version": "0.1.0",
  "private": true,
  "description": "Part-time Coder Unified Company Platform",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "pnpm --filter @ptc/worker build && pnpm --filter @ptc/web build",
    "dev": "pnpm --filter @ptc/web dev",
    "dev:worker": "pnpm --filter @ptc/worker dev",
    "lint": "eslint .",
    "typecheck": "pnpm --recursive run typecheck",
    "test:unit": "vitest run",
    "test:integration": "vitest run integration"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "eslint": "^10.12.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "vitest": "^5.0.4"
  }
}
