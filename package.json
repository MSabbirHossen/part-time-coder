{
  "name": "part-time-coder",
  "version": "0.1.0",
  "private": true,
  "description": "Part-time Coder Unified Company Platform",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "pnpm --filter @ptc/config build && pnpm --recursive --filter \"!@ptc/config\" run build",
    "dev": "pnpm --filter @ptc/web dev",
    "dev:worker": "pnpm --filter @ptc/worker dev",
    "lint": "pnpm --recursive run lint",
    "typecheck": "pnpm --recursive run typecheck",
    "test:unit": "pnpm --recursive --if-present run test:unit",
    "test:integration": "pnpm --recursive --if-present run test:integration"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "prettier": "^3.3.3"
  }
}
